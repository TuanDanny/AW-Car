// Physical QFN88P package numbers, not header positions. No configuration pins reused.
IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// S2 and all six onboard LEDs are 1.8V only.
IO_LOC "arst_n" 3;
IO_PORT "arst_n" IO_TYPE=LVCMOS18 PULL_MODE=UP BANK_VCCIO=1.8;
IO_LOC "spi_mosi" 25;
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "spi_miso" 26;
IO_PORT "spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "spi_sclk" 29;
IO_PORT "spi_sclk" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "spi_cs_n" 30;
IO_PORT "spi_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_left" 27;
IO_PORT "enc_left" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
// Current right encoder has an EXTERNAL level-shifter pull-up; no FPGA pull.
IO_LOC "enc_right" 28;
IO_PORT "enc_right" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "drv_left_in1" 35;
IO_PORT "drv_left_in1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "drv_left_in2" 40;
IO_PORT "drv_left_in2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "drv_right_in1" 41;
IO_PORT "drv_right_in1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "drv_right_in2" 42;
IO_PORT "drv_right_in2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "leds_n[0]" 10;
IO_PORT "leds_n[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=4 BANK_VCCIO=1.8;
IO_LOC "leds_n[1]" 11;
IO_PORT "leds_n[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=4 BANK_VCCIO=1.8;
IO_LOC "leds_n[2]" 13;
IO_PORT "leds_n[2]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=4 BANK_VCCIO=1.8;
IO_LOC "leds_n[3]" 14;
IO_PORT "leds_n[3]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=4 BANK_VCCIO=1.8;
