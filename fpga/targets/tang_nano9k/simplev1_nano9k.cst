IO_PORT "leds_n[4]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=4 BANK_VCCIO=1.8;
IO_LOC "leds_n[5]" 16;
IO_PORT "leds_n[5]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=4 BANK_VCCIO=1.8;
