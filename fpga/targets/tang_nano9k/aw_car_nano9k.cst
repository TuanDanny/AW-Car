// Sipeed schematics 3672 and 3674, PDF page2; GW1NR-9C QFN88P pin database.
// Physical FPGA package numbers, NOT header ordinal or ESP32 GPIO numbers.
IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
