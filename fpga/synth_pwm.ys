# Generic Gowin mapping only: no exact part, pinout, placement or routed timing.
read_verilog -sv fpga/rtl/pwm/pwm_pair.sv fpga/rtl/pwm/motor_pwm_pair.sv
read_verilog -sv fpga/rtl/pwm/drv8833_adapter.sv
design -save pwm_sources
proc
select -assert-none t:$dlatch t:$adlatch
synth_gowin -top motor_pwm_pair -noiopads -nowidelut -json fpga/build/pwm_gowin.json
check -assert
tee -o fpga/build/pwm_stat.json stat -json
design -load pwm_sources
proc
select -assert-none t:$dlatch t:$adlatch
synth_gowin -top drv8833_adapter -noiopads -nowidelut -json fpga/build/drv8833_adapter_gowin.json
check -assert
tee -o fpga/build/drv8833_adapter_stat.json stat -json
