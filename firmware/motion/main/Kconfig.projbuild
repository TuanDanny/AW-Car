menu "AW-Car Motion"
config AWCAR_ENABLE_DRIVER
    bool "Allow verified hardware to ARM (default disabled)"
    default n
    help
        Enable only after verifying the separate default-off hardware gate,
        E-stop, pin assignment, driver current and encoder calibration.
        The saved configuration must also have validated=1. This switch never
        bypasses GPIO, session, status freshness, lease or ARM checks.
config AWCAR_BRAIN_TX
    int "UART1 TX to Brain RX"
    default 13
config AWCAR_BRAIN_RX
    int "UART1 RX from Brain TX"
    default 14
config AWCAR_FPGA_TX
    int "UART2 TX to FPGA RX"
    default 15
config AWCAR_FPGA_RX
    int "UART2 RX from FPGA TX"
    default 16
config AWCAR_MOTION_PERMIT
    int "Logical motion_permit to FPGA"
    default 4
config AWCAR_RECOVERY_REQ
    int "Recovery request to FPGA"
    default 5
config AWCAR_RECOVERY_ACK
    int "Recovery acknowledgement from FPGA"
    default 6
config AWCAR_FPGA_PERMIT
    int "Permit feedback from FPGA"
    default 7
config AWCAR_SAFETY_OK
    int "E-stop/power safety OK input, HIGH=healthy"
    default 8
config AWCAR_GATE_OK
    int "External latch gate_fault_n input, HIGH=healthy"
    default 9
config AWCAR_DRIVER_PERMIT
    int "Separate default-LOW permit to hardware driver gate"
    default 10
endmenu
