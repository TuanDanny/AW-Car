(text "Static FPGA permit HIGH is insufficient: independent edge/heartbeat watchdog must detect lost FPGA clock." (at 20 180 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "f7390117-c93d-5ffc-b6f4-14c56eb7d61d"))
