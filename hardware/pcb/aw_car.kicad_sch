(text "AW-CAR | SO DO DAU NOI CHUNG | 1 TRANG" (at 25.4 20.32 0) (effects (font (size 2.8 2.8)) (justify left)) (uuid "d45943a5-e5e7-529e-9f03-8bb2b10fa0f3"))
(text "Connection review: visible signal wires; power labels share named rails. Module sockets / harness order still to be verified." (at 25.4 27.94 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "a72af156-184f-503c-a2a3-07da11f6fc18"))
(text "01  NGUON 2S + DSN6000AUD" (at 25.4 39.37 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "a45d6e77-898b-5288-b809-f724bf98352a"))
(text "BMS 2S + charger 8.4V: NOT SELECTED. J30 is protected pack output only; not raw cells / not charger input." (at 25.4 96.52 0) (effects (font (size 1.15 1.15)) (justify left)) (uuid "628cf2de-8316-5ca4-9c6f-953892ad4cdd"))
(text "5V_DSN_UNVERIFIED is TEST ONLY. Do not join it to board 5V/USB until source isolation is reviewed." (at 25.4 102.87 0) (effects (font (size 1.15 1.15)) (justify left)) (uuid "e94efe81-dac0-5de7-a045-bf28823c70f5"))
(text "02  AUDIO / OLED" (at 25.4 144.78 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "63c31b8c-d41b-591c-a375-b99efb142a99"))
(text "03  BRAIN <-> MOTION <-> FPGA | 3.3V LOGIC" (at 250.19 124.46 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "30eeed18-d597-5c55-b7c3-3d47940c6bfa"))
(text "Motion GPIO17/18 DAMAGED - NEVER USE. UART uses GPIO13/14 to Brain and GPIO15/16 to Tang." (at 250.19 133.35 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "ed0e4d5b-f590-517f-96a4-5a0f00f3f74c"))
(text "04  DRV8833 x2 / 4 MOTOR TT 9V" (at 640.08 129.54 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "ee43c1d7-25cd-571c-b38b-5b4d0fa927e3"))
(text "Each motor has its own bridge. AIN/BIN share logic only." (at 640.08 138.43 0) (effects (font (size 1.05 1.05)) (justify left)) (uuid "96d992d8-8ae7-54c3-9ed2-4aad048f463d"))
(text "No parallel H-bridge outputs. STBY = nSLEEP: verify module." (at 640.08 143.51 0) (effects (font (size 1.05 1.05)) (justify left)) (uuid "5822bffe-686f-5329-9e25-887662ded35c"))
(text "05  CAM BIEN / ENCODER 1 OUT" (at 25.4 350.52 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "c7060c70-c8d7-5368-9838-03e57574760d"))
