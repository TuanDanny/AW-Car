<diagram id="aw-car-io-v2" name="01 - INPUT OUTPUT"><mxGraphModel dx="1930" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1930" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_title" value="&lt;b&gt;AW CAR | FPGA RTL — INPUT → MODULE → OUTPUT&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontColor=#0f172a;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1440" height="46" as="geometry"/></mxCell><mxCell id="p1_sub" value="&lt;font color='#64748b'&gt;Đối chiếu drive_core.sv (TOP) • clk 27 MHz • đường điều khiển 2 nhóm trái/phải • tất cả các cổng TOP được liệt kê&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1610" height="34" as="geometry"/></mxCell><mxCell id="in_label" value="&lt;b&gt;INPUT VÀO FPGA&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#0369a1;align=center;" vertex="1" parent="1"><mxGeometry x="48" y="122" width="290" height="30" as="geometry"/></mxCell><mxCell id="out_label" value="&lt;b&gt;OUTPUT RA KHỎI FPGA&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#0f766e;align=center;" vertex="1" parent="1"><mxGeometry x="1565" y="122" width="300" height="30" as="geometry"/></mxCell><mxCell id="fpga_chassis" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#f8fbff;strokeColor=#93c5fd;fontColor=#0f172a;fontSize=15;fontFamily=Arial;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="390" y="126" width="1120" height="762" as="geometry"/></mxCell><mxCell id="fpga_label" value="&lt;b&gt;FPGA LOGIC: drive_core.sv&lt;/b&gt;&lt;br&gt;&lt;font color='#64748b'&gt;Những khối bên trong là module SystemVerilog; phần cứng bên ngoài không thuộc RTL.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#1d4ed8;align=center;" vertex="1" parent="1"><mxGeometry x="417" y="134" width="1055" height="56" as="geometry"/></mxCell><mxCell id="input_uart" value="&lt;div style=&quot;font-family:Arial;line-height:1.38&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;ESP32-S3 Motion&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;INPUT 1 · serial&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155&quot;&gt;rx : UART 115200 8N1&lt;br&gt;HELLO / ARM / CMD / DISABLE&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#f0f9ff;strokeColor=#38bdf8;fontColor=#0f172a;fontSize=15;fontFamily=Arial;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="195" width="315" height="106" as="geometry"/></mxCell><mxCell id="input_safe" value="&lt;div style=&quot;font-family:Arial;line-height:1.38&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;GPIO / Mạch an toàn&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;INPUT 2 · nguồn Motion &amp;amp; gate&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155&quot;&gt;motion_permit_async [1]&lt;br&gt;recovery_req_async [1]&lt;br&gt;safety_ok_async [1]&lt;br&gt;gate_fault_n_async [1]&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#fffbeb;strokeColor=#f59e0b;fontColor=#0f172a;fontSize=15;fontFamily=Arial;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="355" width="315" height="175" as="geometry"/></mxCell><mxCell id="input_clk" value="&lt;div style=&quot;font-family:Arial;line-height:1.38&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Clock và Reset&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;INPUT 3&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155&quot;&gt;clk [1] = 27 MHz&lt;br&gt;arst_n [1] active LOW&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=15;fontFamily=Arial;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="575" width="315" height="95" as="geometry"/></mxCell><mxCell id="input_enc" value="&lt;div style=&quot;font-family:Arial;line-height:1.38&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Encoder ngoài&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;INPUT 4 · tín hiệu sensor&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155&quot;&gt;left_ab[1:0] · A/B trái&lt;br&gt;right_ab[1:0] · A/B phải&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#f0fdf4;strokeColor=#4ade80;fontColor=#0f172a;fontSize=15;fontFamily=Arial;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="315" height="116" as="geometry"/></mxCell><mxCell id="mod_link" value="&lt;div style=&quot;font-family:Arial;line-height:1.38&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;TV2 · fpga_link&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;UART RX + kiểm tra&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155&quot;&gt;uart_rx → frame_rx&lt;br&gt;crc16_byte → command_guard&lt;br&gt;Lệnh/phiên hợp lệ&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#f5f3ff;strokeColor=#a78bfa;fontColor=#0f172a;fontSize=15;fontFamily=Arial;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="455" y="219" width="264" height="131" as="geometry"/></mxCell><mxCell id="mod_safety" value="&lt;div style=&quot;font-family:Arial;line-height:1.38&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;TV1 · safety_fsm&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;Security &amp;amp; interlocks&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155&quot;&gt;ARM / FAULT / CLEAR&lt;br&gt;Watchdog 50 ms&lt;br&gt;Quyền chạy motor&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#eff6ff;strokeColor=#60a5fa;fontColor=#0f172a;fontSize=15;fontFamily=Arial;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="817" y="221" width="261" height="150" as="geometry"/></mxCell><mxCell id="mod_pwm" value="&lt;div style=&quot;font-family:Arial;line-height:1.38&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;TV3 · motor_pwm_pair&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;Motor control&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155&quot;&gt;pwm_pair → PWM 20 kHz&lt;br&gt;Trái / phải + direction&lt;br&gt;Chặn lúc đổi chiều&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#f0fdf4;strokeColor=#4ade80;fontColor=#0f172a;fontSize=15;fontFamily=Arial;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1171" y="221" width="255" height="150" as="geometry"/></mxCell><mxCell id="mod_common" value="&lt;div style=&quot;font-family:Arial;line-height:1.38&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;TV1 · Common&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;Reset / sync / lọc GPIO&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155&quot;&gt;reset_sync (x4)&lt;br&gt;input_sync_filter&lt;br&gt;rst_n + inputs_valid&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#eff6ff;strokeColor=#7dd3fc;fontColor=#0f172a;fontSize=15;fontFamily=Arial;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="814" y="495" width="265" height="126" as="geometry"/></mxCell><mxCell id="mod_tx" value="&lt;div style=&quot;font-family:Arial;line-height:1.38&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;TV2 · STATUS TX&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;Sắp xếp frame trả về&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155&quot;&gt;frame_tx → crc16_byte&lt;br&gt;uart_tx (trong fpga_link)&lt;br&gt;Telemetry snapshot + fault&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#f5f3ff;strokeColor=#a78bfa;fontColor=#0f172a;fontSize=15;fontFamily=Arial;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="782" y="681" width="302" height="136" as="geometry"/></mxCell><mxCell id="mod_encoder" value="&lt;div style=&quot;font-family:Arial;line-height:1.38&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;TV3 · encoder_pair&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;Encoder A/B X4 v1&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155&quot;&gt;input_sync_filter (x2)&lt;br&gt;quadrature_decoder (x2)&lt;br&gt;count + snapshot 10 ms&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#f0fdf4;strokeColor=#4ade80;fontColor=#0f172a;fontSize=15;fontFamily=Arial;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1170" y="682" width="256" height="135" as="geometry"/></mxCell><mxCell id="output_motor" value="&lt;div style=&quot;font-family:Arial;line-height:1.38&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;PWM / Direction&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;OUTPUT 1 · tới tầng công suất&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155&quot;&gt;pwm_left, pwm_right [1+1]&lt;br&gt;direction[1:0] [2]&lt;br&gt;→ adapter/gate → 2× DRV8833&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#f0fdf4;strokeColor=#22c55e;fontColor=#0f172a;fontSize=15;fontFamily=Arial;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1560" y="203" width="315" height="145" as="geometry"/></mxCell><mxCell id="output_safe" value="&lt;div style=&quot;font-family:Arial;line-height:1.38&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;GPIO + Diagnostic&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;OUTPUT 2 · gate / Motion / status&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155&quot;&gt;fpga_permit [1]&lt;br&gt;recovery_ack [1]&lt;br&gt;gate_clear [1]&lt;br&gt;safety_state[7:0], fault[15:0]&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#fffbeb;strokeColor=#f59e0b;fontColor=#0f172a;fontSize=15;fontFamily=Arial;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1560" y="426" width="315" height="168" as="geometry"/></mxCell><mxCell id="output_uart" value="&lt;div style=&quot;font-family:Arial;line-height:1.38&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;ESP32-S3 Motion&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;OUTPUT 3 · serial return&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155&quot;&gt;tx [1] · UART STATUS&lt;br&gt;Encoder / State / Fault&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#f5f3ff;strokeColor=#a78bfa;fontColor=#0f172a;fontSize=15;fontFamily=Arial;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1560" y="707" width="315"