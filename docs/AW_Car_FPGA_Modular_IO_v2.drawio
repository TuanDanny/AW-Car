strokeWidth=2;endArrow=block;endFill=1;fontColor=#334155;fontSize=11;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.55;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mod_link" target="mod_pwm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="587" y="190"/><mxPoint x="1311" y="190"/></Array></mxGeometry></mxCell><mxCell id="a14" value="status_sent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=16;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;fontColor=#334155;fontSize=11;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.95;exitY=0;exitDx=0;exitDy=0;entryX=0.89;entryY=1;entryDx=0;entryDy=0;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="mod_tx" target="mod_safety"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1077" y="650"/><mxPoint x="1057" y="401"/></Array></mxGeometry></mxCell><mxCell id="p1_note" value="&lt;b&gt;LƯU Ý:&lt;/b&gt; RTL hiện là 2 kênh PWM trái/phải và 2 encoder A/B, không phải 4 kênh độc lập. V2 1-OUT + adapter DRV8833 + gate độc lập là &lt;b&gt;kế hoạch phần cứng/nâng cấp&lt;/b&gt;, chưa có trong RTL." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=15;align=center;fontColor=#92400e;" vertex="1" parent="1"><mxGeometry x="420" y="901" width="1430" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="aw-car-module-tree-v2" name="02 - 15 RTL MODULES"><mxGraphModel dx="1760" dy="975" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="975" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_title" value="&lt;b&gt;AW CAR | CÂY PHÂN CẤP 15 MODULE RTL&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontColor=#0f172a;align=left;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="1660" height="52" as="geometry"/></mxCell><mxCell id="p2_sub" value="&lt;font color='#64748b'&gt;Các khối là file .sv, không phải mỗi khối một chip riêng • TV1/TV2/TV3 là quyền sở hữu code&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="36" y="71" width="1635" height="32" as="geometry"/></mxCell><mxCell id="p2_top" value="&lt;div style=&quot;font-family:Arial;line-height:1.38&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;drive_core.sv&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;TOP • TV1 phụ trách tích hợp&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#334155&quot;&gt;Top nối 4 nhóm con và phát cổng GPIO&lt;br&gt;clk / arst_n • UART • encoder • PWM&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=15;fontFamily=Arial;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="702" y="123" width="438" height="100" as="geometry"/></mxCell><mxCell id="grp_common" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#eff6ff;strokeColor=#7dd3fc;fontColor=#0f172a;fontSize=15;fontFamily=Arial;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="35" y="318" width="280" heig