        </mxCell>
        <mxCell id="scope_note" parent="1" vertex="1" value="AN TOÀN: CMD phải đúng CRC/phiên/sequence + Safety ARMED + Motion permit + gate ngoài. Timeout 50ms → FAULT/motor OFF; mất lease Brain/Motion hoặc E-stop → khóa driver độc lập. STATUS cũ không cứu watchdog." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fillColor=#FFF3DE;strokeColor=#D7AD60;fontFamily=Arial;fontSize=14;fontColor=#70480F;strokeWidth=1.5;">
