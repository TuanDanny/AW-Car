        <mxCell id="feedback_loop" vertex="1" parent="1" value="VÒNG LẶP: 14 → 06  |  Motion tính PID và phát CMD MỚI ở chu kỳ tiếp theo (mục tiêu 100 Hz); không phát lại duty cache." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#2563EB;fontSize=14;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=middle;">
          <mxGeometry x="58" y="1095" width="1600" height="36" as="geometry" />
        </mxCell>
        <mxCell id="scope_note" parent="1" vertex="1" value="AN TOÀN: CMD phải đúng CRC/phiên/sequence + Safety ARMED + Motion permit + gate ngoài. Timeout 50ms → FAULT/motor OFF; mất lease Brain/Motion hoặc E-stop → khóa driver độc lập. STATUS cũ không cứu watchdog." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fillColor=#FFF3DE;strokeColor=#D7AD60;fontFamily=Arial;fontSize=14;fontColor=#70480F;strokeWidth=1.5;">
          <mxGeometry x="55" y="1149" width="1590" height="111" as="geometry" />
        </mxCell>
        <mxCell id="future_note" vertex="1" parent="1" value="Chú thích: phần Brain→Motion và Web/Xiaozhi điều khiển xe là kiến trúc dự kiến; FPGA UART/Safety/PWM/Encoder là RTL đã có." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#64748B;fontSize=14;fontFamily=Arial;fontStyle=0;align=left;verticalAlign=middle;">
          <mxGeometry x="60" y="1271" width="1590" height="31" as="geometry" />
        </mxCell>
      </root>
