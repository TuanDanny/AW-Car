n" value="clk / reset" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#64748b;strokeWidth=1.8;" edge="1" parent="1" source="clock" target="common"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="293" y="562" /><mxPoint x="293" y="573" /><mxPoint x="755" y="573" /></Array></mxGeometry></mxCell><mxCell id="e-external-gate" value="E-stop: khóa độc lập" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#ea580c;strokeWidth=2;dashed=1;dashPattern=5 5;" edge="1" parent="1" source="safety_io" target="adapter"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="432" /><mxPoint x="20" y="95" /><mxPoint x="1287" y="95" /></Array></mxGeometry></mxCell><mxCell id="notice" value="&lt;b&gt;Chú ý:&lt;/b&gt; RTL hiện là 2 nhóm PWM, encoder hai pha A/B. Mạch adapter và gate phần cứng mới là phần phải triển khai/kiểm chứng; chưa đấu trực tiếp PWM/DIR vào DRV8833." style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fillColor=#fff7ed;strokeColor=#fed7aa;fontSize=14;fontFamily=Arial;fontColor=#92400e;" vertex="1" parent="1"><mxGeometry x="300" y="609" width="1326" height="54" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>