<mxfile host="app.diagrams.net" modified="2026-11-01T03:10:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="aw-fpga-block-v1" name="FPGA - So do khoi"><mxGraphModel dx="1680" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="700" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;AW CAR — SƠ ĐỒ KHỐI FPGA (RTL hiện tại)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="35" y="18" width="1170" height="45" as="geometry" /></mxCell><mxCell id="subtitle" value="&lt;font color=&quot;#475569&quot;&gt;Luồng lệnh → cấp quyền → PWM; encoder → STATUS. Khối trong khung là logic SystemVerilog.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;" vertex="1" parent="1"><mxGeometry x="35" y="61" width="1320" height="24" as="geometry" /></mxCell><mxCell id="fpga_frame" value="" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#93c5fd;strokeWidth=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="285" y="106" width="865" height="490" as="geometry" /></mxCell><mxCell id="fpga_title" value="&lt;b&gt;FPGA Tang Nano 9K • drive_core.sv (TOP)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;27 MHz • 2 kênh motor trái/phải&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="322" y="109" width="720" height="55" as="geometry" /></mxCell><mxCell id="motion" value="&lt;div style=&quot;font-family:Arial;text-align:center;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:17px;color:#0f172a&quot;&gt;ESP32-S3 Motion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;PID + lệnh CMD&lt;br&gt;nhận trạng thái STATUS&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;strokeWidth=2;fillColor=#f8fafc;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="36" y="186" width="218" height="105" as="geometry" /></mxCell><mxCell id="safety_io" value="&lt;div style=&quot;font-family:Arial;text-align:center;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:17px;color:#0f172a&quot;&gt;Tín hiệu an toàn&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;permit • recovery&lt;br&gt;E-stop / gate fault&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;strokeWidth=2;fillColor=#fff7ed;strokeColor=#fdba74;" vertex="1" parent="1"><mxGeometry x="36" y="379" width="218" height="105" as="geometry" /></mxCell><mxCell id="clock" value="&lt;div style=&quot;font-family:Arial;text-align:center;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:17px;color:#0f172a&quot;&gt;Clock + Reset&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;clk • arst_n&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;strokeWidth=2;fillColor=#f8fafc;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="36" y="536" width="218" height="51" as="geometry" /></mxCell><mxCell id="adapter" value="&lt;div style=&quot;font-family:Arial;text-align:center;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:17px;color:#0f172a&quot;&gt;Adapter + Gate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;PWM/DIR → IN1/IN2&lt;br&gt;khóa driver độc lập&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=8;fontFamily=Arial;strokeWidth=2;fillColor=#fff7ed;strokeColor=#fb923c;" vertex="1" parent="1"><mxGeometry x="12